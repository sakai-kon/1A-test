{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1a-choir-practice",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "1a-choir-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "1a-choir-audio"
    }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": "43200",
    "WEB_ORIGIN": "https://sakai-kon.github.io"
  }
}
